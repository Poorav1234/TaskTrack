@{
    ViewData["Title"] = "All Tasks";
    Layout = "../Shared/_AdminLayout.cshtml";
}

@using Repositories.Models

@model IEnumerable<t_task>

<div class="container">

    <h2>All Tasks</h2>
    <form asp-controller="Admin" asp-action="SearchTasks" method="get">

        <div class="row">

            <div class="col-md-2">
                <label>Task Name:</label>

                <input type="text" name="task_name" class="form-control" value="@ViewBag.TaskName"
                       placeholder="Task Name" />
            </div>

            <div class="col-md-2">
                <label>User ID:</label>

                <input type="number" name="user_id" class="form-control" value="@ViewBag.UserId"
                       placeholder="User ID" />
            </div>

            <div class="col-md-2">
                <label>Category:</label>

                <select name="category" class="form-control">

                    <option value="">-- All --</option>

                    <option value="Work" selected="@(ViewBag.Category == "Work")">
                        Work
                    </option>

                    <option value="Personal" selected="@(ViewBag.Category == "Personal")">
                        Personal
                    </option>

                    <option value="Study" selected="@(ViewBag.Category == "Study")">
                        Study
                    </option>

                    <option value="Shopping" selected="@(ViewBag.Category == "Shopping")">
                        Shopping
                    </option>

                </select>
            </div>

            <div class="col-md-2">
                <label>Priority:</label>

                <select name="priority" class="form-control">

                    <option value="">-- All --</option>

                    <option value="Low" selected="@(ViewBag.Priority == "Low")">
                        Low
                    </option>

                    <option value="Medium" selected="@(ViewBag.Priority == "Medium")">
                        Medium
                    </option>

                    <option value="High" selected="@(ViewBag.Priority == "High")">
                        High
                    </option>

                </select>
            </div>

            <div class="col-md-2">
                <label>Status:</label>

                <select name="status" class="form-control">

                    <option value="">-- All --</option>

                    <option value="Pending" selected="@(ViewBag.Status == "Pending")">
                        Pending
                    </option>

                    <option value="In Progress" selected="@(ViewBag.Status == "In Progress")">
                        In Progress
                    </option>

                    <option value="Completed" selected="@(ViewBag.Status == "Completed")">
                        Completed
                    </option>

                    <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">
                        Cancelled
                    </option>

                </select>
            </div>

            <div class="col-md-2">
                <label>Due Date:</label>

                <input type="date" name="due_date" class="form-control" value="@ViewBag.DueDate" />
            </div>

        </div>

        <div class="mt-3">

            <button type="submit" class="btn btn-primary">
                Search
            </button>

            <a asp-controller="Admin" asp-action="Tasks" class="btn btn-secondary">
                Clear
            </a>

        </div>

    </form>
    <div class="mt-4">

        <table class="table table-striped">

            <thead class="thead-dark">

                <tr>

                    <th>Task ID</th>
                    <th>User ID</th>
                    <th>Task Name</th>
                    <th>Category</th>
                    <th>Priority</th>
                    <th>Due Date</th>
                    <th>Status</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var task in Model)
                {
                    <tr>

                        <td>
                            @task.task_id
                        </td>

                        <td>
                            @task.user_id
                        </td>

                        <td>
                            @task.task_name
                        </td>

                        <td>
                            @task.category
                        </td>

                        <td>
                            @task.priority
                        </td>

                        <td>
                            @task.due_date.ToString("dd-MM-yyyy")
                        </td>

                        <td>
                            @task.status
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>