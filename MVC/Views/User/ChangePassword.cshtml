@{
    ViewData["Title"] = "Change Password";
    Layout = "../Shared/_TaskLayout.cshtml";
}

@using Repositories.Models

@model vm_ChangePassword

<div class="container">

    <h2>Change Password</h2>

    <form asp-action="ChangePassword" asp-controller="User" method="post">

        <div class="mt-3">
            <label>Old Password:</label>

            <input type="password" class="form-control" asp-for="old_password">

            <span class="text-danger" asp-validation-for="old_password"></span>
        </div>

        <div class="mt-3">
            <label>New Password:</label>

            <input type="password" class="form-control" asp-for="new_password">

            <span class="text-danger" asp-validation-for="new_password"></span>
        </div>

        <div class="mt-3">
            <label>Confirm Password:</label>

            <input type="password" class="form-control" asp-for="confirm_password">

            <span class="text-danger" asp-validation-for="confirm_password"></span>
        </div>

        <div class="mt-3">

            <button type="submit" class="btn btn-primary">
                Change Password
            </button>

        </div>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-danger mt-3">
                @TempData["Message"]
            </div>
        }

    </form>

</div>