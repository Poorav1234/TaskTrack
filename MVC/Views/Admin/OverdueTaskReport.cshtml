@{
    ViewData["Title"] = "Overdue Task Report";
    Layout = "../Shared/_AdminLayout.cshtml";
}

@using Repositories.Models

@model IEnumerable<vm_OverdueTaskReport>

<div class="container">

    <h2>Overdue Task Report</h2>

    <p class="mt-3">
        Tasks where Due Date is before the current date
        and Status is not Completed.
    </p>

    <table class="table table-striped mt-4">

        <thead class="thead-dark">
            <tr>
                <th>User</th>
                <th>Task</th>
                <th>Due Date</th>
                <th>Priority</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var task in Model)
            {
                <tr>
                    <td>@task.username</td>
                    <td>@task.task_name</td>
                    <td>@task.due_date.ToString("dd-MMM-yyyy")</td>
                    <td>@task.priority</td>
                    <td>@task.status</td>
                </tr>
            }

        </tbody>

    </table>

</div>