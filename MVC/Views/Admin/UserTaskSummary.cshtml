@{
    ViewData["Title"] = "User Task Summary";
    Layout = "../Shared/_AdminLayout.cshtml";
}

@using Repositories.Models

@model IEnumerable<vm_UserTaskSummary>

<div class="container">

    <h2>User Task Summary</h2>

    <p class="mt-3">
        Display the number of tasks created by each user.
    </p>

    <div class="mt-4">

        <table class="table table-striped">

            <thead class="thead-dark">
                <tr>
                    <th>User</th>
                    <th>Total Tasks</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.username</td>
                        <td>@user.total_tasks</td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>