<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TaskTrack Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" />

</head>

<body>

    <header>

        <nav class="navbar navbar-expand-sm navbar-dark bg-dark">

            <div class="container-fluid">

                <a class="navbar-brand" asp-controller="Admin" asp-action="Index">
                    TaskTrack Admin
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="adminNavbar">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">

                            <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                Dashboard
                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link" asp-controller="Admin" asp-action="Users">
                                Users
                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link" asp-controller="Admin" asp-action="Tasks">
                                Tasks
                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link" asp-controller="Admin" asp-action="UserTaskSummary">
                                User Task Summary
                            </a>

                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="TaskStatusReport">
                                Task Status Report
                            </a>

                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="OverdueTaskReport">
                                Task Category Report
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="TasksDueOnDate">
                                Tasks Due on Date
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="UserTaskDetail">
                                User & Task Details
                            </a>
                        </li>

                    </ul>

                    <ul class="navbar-nav">

                        <li class="nav-item">

                            <a class="nav-link" asp-controller="Admin" asp-action="Logout">
                                Logout
                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <main class="container mt-4">

        @RenderBody()

    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>