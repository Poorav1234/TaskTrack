@{
    ViewData["Title"] = "User and Task Detail Report";
    Layout = "../Shared/_AdminLayout.cshtml";
}

@using Repositories.Models

@model IEnumerable<vm_UserTaskDetail>

<div class="container">

    <h2>User and Task Detail Report</h2>

    <form asp-controller="Admin"
          asp-action="UserTaskDetail"
          method="get"
          class="mt-4">

        <div class="row">

            <div class="col-md-4">

                <label>Select User:</label>

                <select name="user_id"
                        class="form-control">

                    <option value="">-- Select User --</option>

                    @foreach (var user in ViewBag.Users)
                    {
                        <option value="@user.user_id"
                                selected="@(ViewBag.UserId == user.user_id)">
                            @user.username
                        </option>
                    }

                </select>

            </div>

        </div>

        <div class="mt-3">

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

            <a asp-controller="Admin"
               asp-action="UserTaskDetail"
               class="btn btn-secondary">
                Clear
            </a>

        </div>

    </form>

    @if (ViewBag.Username != null)
    {
        <h5 class="mt-4">
            Selected User: @ViewBag.Username
        </h5>

        <table class="table table-striped mt-3">

            <thead class="thead-dark">
                <tr>
                    <th>Task Name</th>
                    <th>Category</th>
                    <th>Priority</th>
                    <th>Due Date</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var task in Model)
                {
                    <tr>
                        <td>@task.task_name</td>
                        <td>@task.category</td>
                        <td>@task.priority</td>
                        <td>@task.due_date.ToString("dd-MMM-yyyy")</td>
                        <td>@task.status</td>
                    </tr>
                }

            </tbody>

        </table>
    }

</div>