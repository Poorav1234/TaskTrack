@{
    ViewData["Title"] = "Tasks Due on Selected Date";
    Layout = "../Shared/_AdminLayout.cshtml";
}

@using Repositories.Models

@model IEnumerable<vm_TasksDueOnDate>

<div class="container">

    <h2>Tasks Due on Selected Date</h2>

    <form asp-controller="Admin"
          asp-action="TasksDueOnDate"
          method="get"
          class="mt-4">

        <div class="row">

            <div class="col-md-4">
                <label>Select Date:</label>

                <input type="date"
                       name="due_date"
                       class="form-control"
                       value="@ViewBag.DueDate" />
            </div>

        </div>

        <div class="mt-3">

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

            <a asp-controller="Admin"
               asp-action="TasksDueOnDate"
               class="btn btn-secondary">
                Clear
            </a>

        </div>

    </form>

    @if (ViewBag.DueDate != null)
    {
        <table class="table table-striped mt-4">

            <thead class="thead-dark">
                <tr>
                    <th>User</th>
                    <th>Task</th>
                    <th>Priority</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var task in Model)
                {
                    <tr>
                        <td>@task.username</td>
                        <td>@task.task_name</td>
                        <td>@task.priority</td>
                        <td>@task.status</td>
                    </tr>
                }

            </tbody>

        </table>
    }

</div>