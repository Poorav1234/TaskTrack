@{
    ViewData["Title"] = "Tasks";
    Layout = "../Shared/_TaskLayout.cshtml";
}

@using Repositories
@using Repositories.Models

@model t_task

<div class="container">

    <form asp-action="Create" asp-controller="Task" method="post">

        <div class="modal-body">

            <input type="hidden" asp-for="task_id" id="task_id">


            <div class="mt-3">
                <label class="control-label mt-1" for="task_name">
                    Task Name:
                </label>

                <div class="mt-1">
                    <input type="text"
                           class="form-control"
                           asp-for="task_name"
                           id="task_name"
                           placeholder="Enter task name">
                </div>

                <span class="text-danger"
                      asp-validation-for="task_name"></span>
            </div>


            <div class="mt-3">
                <label class="control-label mt-1" for="category">
                    Category:
                </label>

                <div class="mt-1">

                    <select id="category"
                            asp-for="category"
                            class="form-control">

                        <option value="">-- Select Category --</option>
                        <option value="Work">Work</option>
                        <option value="Personal">Personal</option>
                        <option value="Study">Study</option>
                        <option value="Shopping">Shopping</option>

                    </select>

                </div>

                <span class="text-danger"
                      asp-validation-for="category"></span>
            </div>


            <div class="mt-3">
                <label class="control-label mt-1" for="priority">
                    Priority:
                </label>

                <div class="mt-1">

                    <select id="priority"
                            asp-for="priority"
                            class="form-control">

                        <option value="">-- Select Priority --</option>
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>

                    </select>

                </div>

                <span class="text-danger"
                      asp-validation-for="priority"></span>
            </div>


            <div class="mt-3">
                <label class="control-label mt-1" for="due_date">
                    Due Date:
                </label>

                <div class="mt-1">

                    <input type="date"
                           class="form-control"
                           asp-for="due_date"
                           id="due_date"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")">

                </div>

                <span class="text-danger"
                      asp-validation-for="due_date"></span>
            </div>


            <div class="mt-3">
                <label class="control-label mt-1" for="status">
                    Status:
                </label>

                <div class="mt-1">

                    <select id="status"
                            asp-for="status"
                            class="form-control">

                        <option value="">-- Select Status --</option>
                        <option value="Pending">Pending</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>

                    </select>

                </div>

                <span class="text-danger"
                      asp-validation-for="status"></span>
            </div>


            <div id="responseMessage" class="mt-3">

                <div class="alert @(TempData["Message"] != null ? "alert-danger" : "")">
                    @TempData["Message"]
                </div>

            </div>

        </div>


        <div class="modal-footer">

            <button type="submit"
                    class="btn btn-primary"
                    id="btnSave">
                Submit
            </button>

        </div>

    </form>

</div>