@{
    ViewData["Title"] = "Tasks";
    Layout = "../Shared/_TaskLayout.cshtml";
}

@using Repositories
@using Repositories.Models

@model t_task

<div class="container">

    <form asp-action="Create" asp-controller="Task" method="post">

        <div class="modal-body">

            <input type="hidden" asp-for="task_id" id="task_id">


            <div class="mt-3">
                <label class="control-label mt-1" for="user_id">User ID:</label>

                <div class="mt-1">
                    <input type="number" class="form-control"
                           asp-for="user_id"
                           id="user_id"
                           placeholder="Enter user ID">
                </div>

                <span class="text-danger" asp-validation-for="user_id"></span>
            </div>


            <div class="mt-3">
                <label class="control-label mt-1" for="task_name">Task Name:</label>

                <div class="mt-1">
                    <input type="text" class="form-control"
                           asp-for="task_name"
                           id="task_name"
                           placeholder="Enter task name">
                </div>

                <span class="text-danger" asp-validation-for="task_name"></span>
            </div>


            <div class="mt-3">
                <label class="control-label mt-1">Category:</label>

                <div class="mt-1">

                    <input class="category-checkbox"
                           type="checkbox"
                           id="work"
                           value="Work">

                    <label for="work">Work</label>

                    <input class="category-checkbox"
                           type="checkbox"
                           id="personal"
                           value="Personal">

                    <label for="personal">Personal</label>

                    <input class="category-checkbox"
                           type="checkbox"
                           id="study"
                           value="Study">

                    <label for="study">Study</label>

                    <input class="category-checkbox"
                           type="checkbox"
                           id="shopping"
                           value="Shopping">

                    <label for="shopping">Shopping</label>

                    <input type="hidden"
                           id="category"
                           asp-for="category">

                </div>

                <span class="text-danger" asp-validation-for="category"></span>
            </div>


            <div class="mt-3">
                <label class="control-label mt-1" for="priority">Priority:</label>

                <div class="mt-1">

                    <select id="priority"
                            asp-for="priority"
                            class="form-control">

                        <option value="">-- Select Priority --</option>
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>

                    </select>

                </div>

                <span class="text-danger" asp-validation-for="priority"></span>
            </div>


            <div class="mt-3">
                <label class="control-label mt-1" for="due_date">
                    Due Date:
                </label>

                <div class="mt-1">

                    <input type="date"
                           class="form-control"
                           asp-for="due_date"
                           id="due_date">

                </div>

                <span class="text-danger" asp-validation-for="due_date"></span>
            </div>


            <div class="mt-3">
                <label class="control-label mt-1" for="status">
                    Status:
                </label>

                <div class="mt-1">

                    <select id="status"
                            asp-for="status"
                            class="form-control">

                        <option value="">-- Select Status --</option>
                        <option value="Pending">Pending</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Completed">Completed</option>

                    </select>

                </div>

                <span class="text-danger" asp-validation-for="status"></span>
            </div>


            <div id="responseMessage" class="mt-3">

                <div class="alert @(TempData["Message"] != null ? "alert-danger" : "")">
                    @TempData["Message"]
                </div>

            </div>

        </div>


        <div class="modal-footer">

            <button type="submit"
                    class="btn btn-primary"
                    id="btnSave">
                Submit
            </button>

        </div>

    </form>

</div>


<script>

    document.querySelectorAll('.category-checkbox').forEach(checkbox => {

        checkbox.addEventListener('change', () => {

            const selectedValues =
                Array.from(
                    document.querySelectorAll('.category-checkbox:checked')
                )
                .map(cb => cb.value)
                .join(',');

            document.getElementById('category').value = selectedValues;

        });

    });

</script>