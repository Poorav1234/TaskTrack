@{
    ViewData["Title"] = "Tasks";
    Layout = "../Shared/_TaskLayout.cshtml";
}

@using Repositories
@using Repositories.Models

@model IEnumerable<t_task>

<div class="container mt-4">

    <h3>My Tasks</h3>

    <div id="responseMessage" class="mt-3">
        <div class="alert @(TempData["Message"] != null ? "alert-primary" : "")">
            @TempData["Message"]
        </div>
    </div>

    <table class="table table-striped" id="taskTable">

        <thead class="thead-dark">
            <tr>
                <th>Edit</th>
                <th>Task Name</th>
                <th>Category</th>
                <th>Priority</th>
                <th>Due Date</th>
                <th>Status</th>
                <th>Delete</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var task in Model)
            {
                <tr style="vertical-align: middle;">

                    <td>
                        <a href="@Url.Action("Create", "Task", new { id = task.task_id })"
                           class="btn btn-sm btn-primary">
                            Edit
                        </a>
                    </td>

                    <td>@task.task_name</td>

                    <td>@task.category</td>

                    <td>@task.priority</td>

                    <td>@task.due_date.ToString("dd-MM-yyyy")</td>

                    <td>@task.status</td>

                    <td>
                        <a href="@Url.Action("Delete", "Task", new { id = task.task_id })"
                           class="btn btn-sm btn-danger">
                            Delete
                        </a>
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>