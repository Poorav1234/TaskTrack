@{
    ViewData["Title"] = "My Tasks";
    Layout = "../Shared/_TaskLayout.cshtml";
}

@using Repositories
@using Repositories.Models

@model IEnumerable<t_task>

<div class="container mt-4">

    <h3>Tasks</h3>

    <form asp-controller="Task"
      asp-action="Search"
      method="get">

    <div class="row">

        <div class="col-md-2">
            <label>Task Name:</label>

            <input type="text"
                   name="search"
                   class="form-control"
                   placeholder="Task Name"
                   value="@ViewBag.Search" />
        </div>

        <div class="col-md-2">
            <label>Category:</label>

            <select name="category"
                    class="form-control">

                <option value="">-- All --</option>

                <option value="Work"
                    selected="@(ViewBag.Category == "Work")">
                    Work
                </option>

                <option value="Personal"
                    selected="@(ViewBag.Category == "Personal")">
                    Personal
                </option>

                <option value="Study"
                    selected="@(ViewBag.Category == "Study")">
                    Study
                </option>

                <option value="Shopping"
                    selected="@(ViewBag.Category == "Shopping")">
                    Shopping
                </option>

            </select>
        </div>

        <div class="col-md-2">
            <label>Priority:</label>

            <select name="priority"
                    class="form-control">

                <option value="">-- All --</option>

                <option value="Low"
                    selected="@(ViewBag.Priority == "Low")">
                    Low
                </option>

                <option value="Medium"
                    selected="@(ViewBag.Priority == "Medium")">
                    Medium
                </option>

                <option value="High"
                    selected="@(ViewBag.Priority == "High")">
                    High
                </option>

            </select>
        </div>

        <div class="col-md-2">
            <label>Status:</label>

            <select name="status"
                    class="form-control">

                <option value="">-- All --</option>

                <option value="Pending"
                    selected="@(ViewBag.Status == "Pending")">
                    Pending
                </option>

                <option value="In Progress"
                    selected="@(ViewBag.Status == "In Progress")">
                    In Progress
                </option>

                <option value="Completed"
                    selected="@(ViewBag.Status == "Completed")">
                    Completed
                </option>
                <option value="Cancelled"
                    selected="@(ViewBag.Status == "Cancelled")">
                    Cancelled
                </option>

            </select>
        </div>

        <div class="col-md-2">
            <label>Due Date:</label>

            <input type="date"
                   name="due_date"
                   class="form-control"
                   value="@ViewBag.DueDate" />
        </div>

        <div class="col-md-2 mt-4">

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

            <a asp-controller="Task"
               asp-action="ClearSearch"
               class="btn btn-secondary">
                Clear
            </a>

        </div>

    </div>

</form>


    <div id="responseMessage" class="mt-3">

        <div class="alert @(TempData["Message"] != null ? "alert-primary" : "")">
            @TempData["Message"]
        </div>

    </div>


    <table class="table table-striped mt-3" id="taskTable">

        <thead class="thead-dark">

            <tr>

                <th>Edit</th>
                <th>Task Name</th>
                <th>Category</th>
                <th>Priority</th>
                <th>Due Date</th>
                <th>Status</th>
                <th>Delete</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var task in Model)
            {
                <tr style="vertical-align: middle;">

                    <td>
                        <a href="@Url.Action("Create", "Task", new { id = task.task_id })" class="btn btn-sm btn-primary">
                            Edit
                        </a>
                    </td>

                    <td>
                        @task.task_name
                    </td>

                    <td>
                        @task.category
                    </td>

                    <td>
                        @task.priority
                    </td>

                    <td>
                        @task.due_date.ToString("dd-MM-yyyy")
                    </td>

                    <td>
                        @task.status
                    </td>

                    <td>

                        <a href="@Url.Action("Delete", "Task", new { id = task.task_id })" class="btn btn-sm btn-danger">
                            Delete
                        </a>

                        <a asp-controller="Task" asp-action="Details" asp-route-id="@task.task_id" class="btn btn-info">
                            View
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>