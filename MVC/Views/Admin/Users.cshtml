@{
    ViewData["Title"] = "Registered Users";
    Layout = "../Shared/_AdminLayout.cshtml";
}

@using Repositories.Models

@model IEnumerable<t_user>

<div class="container">

    <h2>Registered Users</h2>
    <form asp-controller="Admin" asp-action="SearchUsers" method="get">

        <div class="row">

            <div class="col-md-2">
                <label>Username:</label>

                <input type="text" name="username" class="form-control" value="@ViewBag.Username"
                       placeholder="Username" />
            </div>

            <div class="col-md-2">
                <label>Email:</label>

                <input type="text" name="email" class="form-control" value="@ViewBag.Email" placeholder="Email" />
            </div>

            <div class="col-md-2">
                <label>Mobile:</label>

                <input type="text" name="mobile" class="form-control" value="@ViewBag.Mobile" placeholder="Mobile" />
            </div>

            <div class="col-md-2">
                <label>Gender:</label>

                <select name="gender" class="form-control">

                    <option value="">-- All --</option>

                    <option value="Male" selected="@(ViewBag.Gender == "Male")">
                        Male
                    </option>

                    <option value="Female" selected="@(ViewBag.Gender == "Female")">
                        Female
                    </option>

                    <option value="Other" selected="@(ViewBag.Gender == "Other")">
                        Other
                    </option>

                </select>
            </div>

            <div class="col-md-2">
                <label>City:</label>

                <select name="city" class="form-control">

                    <option value="">-- All --</option>

                    <option value="Ahmedabad" selected="@(ViewBag.City == "Ahmedabad")">
                        Ahmedabad
                    </option>

                    <option value="Bangalore" selected="@(ViewBag.City == "Bangalore")">
                        Bangalore
                    </option>

                    <option value="Chandigarh" selected="@(ViewBag.City == "Chandigarh")">
                        Chandigarh
                    </option>

                    <option value="Chennai" selected="@(ViewBag.City == "Chennai")">
                        Chennai
                    </option>

                    <option value="Delhi" selected="@(ViewBag.City == "Delhi")">
                        Delhi
                    </option>

                    <option value="Hyderabad" selected="@(ViewBag.City == "Hyderabad")">
                        Hyderabad
                    </option>

                    <option value="Indore" selected="@(ViewBag.City == "Indore")">
                        Indore
                    </option>

                    <option value="Jaipur" selected="@(ViewBag.City == "Jaipur")">
                        Jaipur
                    </option>

                    <option value="Kolkata" selected="@(ViewBag.City == "Kolkata")">
                        Kolkata
                    </option>

                    <option value="Mumbai" selected="@(ViewBag.City == "Mumbai")">
                        Mumbai
                    </option>

                    <option value="Pune" selected="@(ViewBag.City == "Pune")">
                        Pune
                    </option>

                    <option value="Rajkot" selected="@(ViewBag.City == "Rajkot")">
                        Rajkot
                    </option>

                    <option value="Surat" selected="@(ViewBag.City == "Surat")">
                        Surat
                    </option>

                    <option value="Vadodara" selected="@(ViewBag.City == "Vadodara")">
                        Vadodara
                    </option>

                </select>
            </div>

        </div>

        <div class="mt-3">

            <button type="submit" class="btn btn-primary">
                Search
            </button>

            <a asp-controller="Admin" asp-action="Users" class="btn btn-secondary">
                Clear
            </a>

        </div>

    </form>
    <div class="mt-4">

        <table class="table table-striped">

            <thead class="thead-dark">

                <tr>

                    <th>User ID</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Mobile</th>
                    <th>Gender</th>
                    <th>City</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var user in Model)
                {
                    <tr>

                        <td>
                            @user.user_id
                        </td>

                        <td>
                            @user.username
                        </td>

                        <td>
                            @user.email
                        </td>

                        <td>
                            @user.mobile
                        </td>

                        <td>
                            @user.gender
                        </td>

                        <td>
                            @user.city
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>