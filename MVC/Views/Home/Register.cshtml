@using Repositories.Models

@model t_user

@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5" style="border: 1px solid #ccc; width: 70%; padding: 20px">

    <h3>Register</h3>

    <form asp-controller="Home" asp-action="Register" method="post" id="registerForm">

        <div class="mt-3">
            <label class="control-label">Username:</label>

            <input type="text" class="form-control" asp-for="username"
                   placeholder="Enter username">

            <span class="text-danger" asp-validation-for="username"></span>
        </div>


        <div class="mt-3">
            <label class="control-label">Email:</label>

            <input type="email" class="form-control" asp-for="email"
                   placeholder="Enter email">

            <span class="text-danger" asp-validation-for="email"></span>
        </div>


        <div class="mt-3">
            <label class="control-label">Mobile:</label>

            <input type="text" class="form-control" asp-for="mobile"
                   placeholder="Enter mobile number">

            <span class="text-danger" asp-validation-for="mobile"></span>
        </div>


        <div class="mt-3">
            <label class="control-label">Gender:</label>

            <div>
                <input type="radio" asp-for="gender" value="Male" id="male">
                <label for="male">Male</label>

                <input type="radio" asp-for="gender" value="Female" id="female">
                <label for="female">Female</label>

                <input type="radio" asp-for="gender" value="Other" id="other">
                <label for="other">Other</label>
            </div>

            <span class="text-danger" asp-validation-for="gender"></span>
        </div>


        <div class="mt-3">
            <label class="control-label">City:</label>

            <select class="form-control" asp-for="city">
                <option value="">-- Select City --</option>
                <option value="Ahmedabad">Ahmedabad</option>
                <option value="Bangalore">Bangalore</option>
                <option value="Chandigarh">Chandigarh</option>
                <option value="Chennai">Chennai</option>
                <option value="Delhi">Delhi</option>
                <option value="Hyderabad">Hyderabad</option>
                <option value="Indore">Indore</option>
                <option value="Jaipur">Jaipur</option>
                <option value="Kolkata">Kolkata</option>
                <option value="Mumbai">Mumbai</option>
                <option value="Pune">Pune</option>
                <option value="Rajkot">Rajkot</option>
                <option value="Surat">Surat</option>
                <option value="Vadodara">Vadodara</option>
            </select>

            <span class="text-danger" asp-validation-for="city"></span>
        </div>


        <div class="mt-3">
            <label class="control-label">Password:</label>

            <input type="password" class="form-control" asp-for="password"
                   placeholder="Enter password">

            <span class="text-danger" asp-validation-for="password"></span>
        </div>


        <div class="mt-3">
            <label class="control-label">Confirm Password:</label>

            <input type="password" class="form-control" asp-for="confirm_password"
                   placeholder="Confirm password">

            <span class="text-danger" asp-validation-for="confirm_password"></span>
        </div>


        <div class="mt-4">
            <button type="submit" class="btn btn-primary">
                Register
            </button>

            <a asp-controller="Home" asp-action="Login"
               class="btn btn-secondary">
                Login
            </a>
        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        $("#registerForm").submit(function (e) {

            if (!$(this).valid()) {

                e.preventDefault();

                Swal.fire({
                    icon: "error",
                    title: "Validation Error",
                    text: "Please enter all required details correctly.",
                    confirmButtonText: "OK"
                });

            }

        });

    </script>

}